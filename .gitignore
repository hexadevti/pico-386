# build output
build/
build-*/
*.o
*.obj
*.exe
*.dll

# the desktop build's SD card. Only what may be shared is committed: the BIOS (LGPL), free and
# empty disk images, and the tests. Never commit MS-DOS, Windows or games.
sdcard/*
!sdcard/README.md
!sdcard/pico-386/
sdcard/pico-386/*
!sdcard/pico-386/disks/
!sdcard/pico-386/roms/
!sdcard/pico-386/m12.ini
!sdcard/pico-386/m13.ini
!sdcard/pico-386/beep.ini
!sdcard/pico-386/cdboot.ini
!sdcard/pico-386/rp2350.ini

.claude/
sdcard/pico-386/disks/freedos-hdd-128mb/
__pycache__/
